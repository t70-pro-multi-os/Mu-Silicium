[Manufacturer]
%Provider%=Models,NTarm64.10.0...26100

[Models.NTarm64.10.0...26100]
%Description%=Install,ACPI\HANA679B

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
