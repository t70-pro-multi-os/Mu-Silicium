[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/22/2026,1.0.0.0
CatalogFile=MtkBtif.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12
DriverCopyFiles=12

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
MtkBtif.sys=1

[Manufacturer]
%Provider%=Models,NTarm64

[Models.NTarm64]
%DeviceDescription%=MtkBtif_Install,ACPI\HANA6795

[MtkBtif_Install.NT]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
MtkBtif.sys

[MtkBtif_Install.NT.Services]
AddService=MtkBtif,0x00000002,MtkBtif_Service

[MtkBtif_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\MtkBtif.sys

[MtkBtif_Install.NT.Wdf]
KmdfService=MtkBtif,MtkBtif_Wdf

[MtkBtif_Wdf]
KmdfLibraryVersion=1.33

[Strings]
Provider="T70 Pro community port"
DeviceDescription="T70 Pro Bluetooth interface"
ServiceDescription="T70 Pro BTIF controller"
DiskName="T70 Pro BTIF driver"
