#!/usr/bin/env python3
"""Run one builder job while holding the shared workspace build marker."""
import datetime
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import uuid

if len(sys.argv) < 5 or sys.argv[3] != "--":
    sys.exit("usage: with-build-lock MODEL DESCRIPTION -- COMMAND [ARG ...]")
marker = Path("/mnt/mac/Users/you/.tmp/build.lock")
if sys.platform == "darwin":
    marker = Path(str(marker).removeprefix("/mnt/mac"))
token = uuid.uuid4().hex
try:
    handle = marker.open("x")
except FileExistsError:
    sys.exit("A build already holds " + str(marker))
child = None

def stop(signum, frame):
    if child is not None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    raise SystemExit(128 + signum)

try:
    with handle:
        json.dump({"model": sys.argv[1], "description": sys.argv[2],
                   "machine": "builder", "pid": os.getpid(), "token": token,
                   "started_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, handle)
        handle.write("\n")
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    child = subprocess.Popen(sys.argv[4:], start_new_session=True)
    result = child.wait()
finally:
    # Never wait from a signal handler: Popen.wait may already hold its lock.
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    if child is not None and child.poll() is None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.wait()
    if marker.exists() and json.loads(marker.read_text()).get("token") == token:
        marker.unlink()
sys.exit(result)
