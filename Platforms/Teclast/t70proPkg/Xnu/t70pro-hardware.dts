    psci { compatible = "arm,psci-1.0"; method = "smc"; };
    gic: interrupt-controller@c000000 {
        unixnu,adt-name = "intc"; compatible = "arm,gic-v3";
        interrupt-controller; #interrupt-cells = <4>; #address-cells = <2>; #size-cells = <2>; ranges;
        reg = <0 0xc000000 0 0x40000>, <0 0xc040000 0 0x200000>;
        #redistributor-regions = <1>; interrupts = <1 9 4 0>;
    };
    timer { unixnu,adt-name = "timer"; compatible = "arm,armv8-timer";
        clock-frequency = <13000000>;
        interrupts = <1 13 4 0>, <1 14 4 0>, <1 11 4 0>, <1 10 4 0>;
    };
};
